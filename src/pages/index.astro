---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE, SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>Joy Paulsen <span class="text-skin-accent">Blog</span></h1>

      <figure>
        <img src="/assets/DSC02111.jpg" alt="Icelandic mountain range" />
        <figcaption>Spring Mountains in Southern Iceland</figcaption>
      </figure>

      <p>
        Exploring data, computation, reliability, and sustainable systems. Writing about what I'm working on and learning about in my day job and personal pursuits.
      </p>

    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <h2>Featured</h2>
            <ul>
              {featuredPosts.map(({ data, slug }) => (
                <Card
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Recent Posts</h2>
          <ul>
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={`/posts/${slug}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <a href="/posts/" class="all-posts-btn">
        All Posts
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Hero Section ===== */
  #hero {
    @apply pb-6 pt-8;
  }
  #hero h1 {
    @apply mb-6 mt-2 block text-4xl font-semibold tracking-tight sm:text-5xl;
  }
  #hero figure {
    @apply mb-8;
  }
  #hero figure img {
    @apply w-full rounded-sm object-cover shadow-md;
    aspect-ratio: 16 / 7;
  }
  #hero figcaption {
    @apply mt-2 text-xs italic opacity-50;
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply mb-2 h-6 w-6 scale-110 fill-skin-accent sm:mb-3 sm:scale-125;
  }
  #hero p {
    @apply mb-4 text-lg leading-relaxed;
  }
  .social-wrapper {
    @apply mt-4 flex flex-col sm:flex-row sm:items-center;
  }
  .social-links {
    @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
  }

  /* ===== Featured & Recent Posts Sections ===== */
  #featured,
  #recent-posts {
    @apply pb-6 pt-12;
  }
  #featured h2,
  #recent-posts h2 {
    @apply font-sans text-2xl font-semibold tracking-tight;
    display: inline-block;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid rgb(var(--color-accent));
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
  .all-posts-btn {
    @apply inline-flex items-center gap-2 border border-skin-accent px-5 py-2 text-sm font-medium text-skin-accent transition-colors duration-200 hover:bg-skin-accent hover:text-skin-inverted;
  }
  .all-posts-btn svg {
    @apply !h-4 !w-4 transition-colors duration-200;
    fill: rgb(var(--color-accent));
  }
  .all-posts-btn:hover svg {
    fill: rgb(var(--color-fill));
  }
</style>
